generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  position     String?  // Cargo / puesto de la persona
  role         String   @default("user") // "admin" | "user"
  mustChangePassword Boolean @default(true) // Obliga a cambiar la contrasena en el proximo ingreso
  createdAt    DateTime @default(now())

  @@map("users")
}

// Tipo de riesgo (fisico, biologico, mecanico, quimico, etc.)
// La tabla se mantiene como "recipients" por compatibilidad con los datos existentes.
model Recipient {
  id        String   @id @default(cuid())
  idNumber  String?  @unique // (legado, ya no se usa para tipos de riesgo)
  name      String   // Nombre del tipo de riesgo
  area      String?  // (legado, opcional)
  createdAt DateTime @default(now())

  reports   Report[] @relation("ReportRecipients")

  @@map("recipients")
}

model Report {
  id        String   @id @default(cuid())
  author    String   // Nombre de quien hizo el reporte (texto para mostrar)
  authorId  String?  // Id del usuario que lo creo (para validar permisos)
  recipient String   // Resumen de destinatarios (texto legible, para mostrar/exportar)
  reportDate DateTime // Fecha del reporte
  content   String?  // Contenido / detalle (opcional)
  imageUrl  String?  // URL de la imagen adjunta (Supabase Storage), opcional
  createdAt DateTime @default(now())
  editedAt  DateTime? // Fecha de la ultima edicion (null si nunca se edito)
  editedBy  String?   // Quien hizo la ultima edicion

  recipients Recipient[] @relation("ReportRecipients")
  edits      ReportEdit[]

  @@map("reports")
}

model ReportEdit {
  id          String   @id @default(cuid())
  reportId    String
  editedBy    String   // Nombre de quien edito
  editedAt    DateTime @default(now())
  // Estado del reporte ANTES de esta edicion (version anterior)
  recipient   String
  reportDate  DateTime
  content     String?
  imageUrl    String?  // Imagen que tenia antes de la edicion

  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_edits")
}

// Capacitacion (se monta en la app, se visualiza publicamente por link)
model Training {
  id          String   @id @default(cuid())
  title       String   // Titulo de la capacitacion
  description String?  // Descripcion corta
  content     String?  // Contenido en texto (puede llevar saltos de linea)
  embedUrl    String?  // Enlace externo a incrustar (video, web) - opcional
  fileUrl     String?  // PDF subido a Supabase - opcional
  minMinutes  Int      @default(0) // Tiempo minimo (min) antes de confirmar; 0 = sin temporizador
  requireAttendance Boolean @default(true) // Si pide registro de asistencia (false = solo informativa)
  accessKey   String?  // Clave de acceso opcional; si existe, el link la pide
  groupLabel  String?  // Grupo/convocatoria/empresa activa actual (etiqueta la tanda vigente)
  active      Boolean  @default(true) // Si los registros estan abiertos
  createdAt   DateTime @default(now())

  attendances TrainingAttendance[]
  questions   TrainingQuestion[]

  @@map("trainings")
}

// Pregunta del cuestionario de una capacitacion
model TrainingQuestion {
  id         String   @id @default(cuid())
  trainingId String
  question   String   // Texto de la pregunta
  options    String   // Opciones separadas por salto de linea (JSON string)
  correct    Int      // Indice de la opcion correcta (0, 1, 2...)
  orden      Int      @default(0)

  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@index([trainingId])
  @@map("training_questions")
}

// Registro de asistencia: quien realizo la capacitacion
model TrainingAttendance {
  id         String   @id @default(cuid())
  trainingId String
  fullName   String   // Nombre completo del asistente
  idNumber   String   // Cedula
  company    String?  // Empresa (para contratistas)
  position   String?  // Cargo (opcional)
  groupLabel String?  // Grupo/convocatoria al que pertenece esta asistencia
  passedQuiz Boolean  @default(false) // Si aprobo el cuestionario
  createdAt  DateTime @default(now()) // Fecha/hora en que la realizo

  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@index([trainingId])
  @@map("training_attendances")
}
