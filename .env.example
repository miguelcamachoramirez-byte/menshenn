# Cadena de conexion a PostgreSQL
# Formato: postgresql://USUARIO:CONTRASENA@HOST:PUERTO/NOMBRE_DB?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reportes?schema=public"

# Secreto para firmar las sesiones (JWT). Usa una cadena larga y aleatoria (min 32 chars).
JWT_SECRET="genera-un-secreto-largo-y-aleatorio"

# Credenciales del administrador inicial (usadas por "npm run seed:admin")
ADMIN_EMAIL="admin@ejemplo.com"
ADMIN_PASSWORD="cambia-esta-contrasena"
ADMIN_NAME="Administrador"
ADMIN_POSITION="Administrador"
