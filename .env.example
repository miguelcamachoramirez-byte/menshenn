# Cadena de conexion a PostgreSQL (Supabase)
# DATABASE_URL: usar el pooler (Transaction, puerto 6543) con pgbouncer=true
DATABASE_URL="postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: conexion directa (puerto 5432) para migraciones de Prisma
DIRECT_URL="postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Secreto para firmar las sesiones (JWT). Usa una cadena larga y aleatoria (min 32 chars).
JWT_SECRET="genera-un-secreto-largo-y-aleatorio"

# Credenciales del administrador inicial (usadas por "npm run seed:admin")
ADMIN_EMAIL="admin@ejemplo.com"
ADMIN_PASSWORD="cambia-esta-contrasena"
ADMIN_NAME="Administrador"
ADMIN_POSITION="Administrador"

# Supabase Storage (imagenes de reportes)
NEXT_PUBLIC_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_SECRET_KEY="tu-secret-key-de-supabase"
SUPABASE_BUCKET="reportes"
